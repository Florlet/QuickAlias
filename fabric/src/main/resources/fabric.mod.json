{
    "schemaVersion": 1,
    "id": "quickalias",
    "version": "${version}",
    "name": "${mod_name}",
    "description": "${description}",
    "authors": [
        "${mod_author}"
    ],
    "contact": {
        "homepage": "https://quickalias.pages.dev",
        "sources": "https://github.com/Florlet/QuickAlias",
        "issues": "https://github.com/Florlet/QuickAlias/issues"
    },
    "license": "${license}",
    "icon": "quickalias.png",
    "environment": "client",
    "entrypoints": {
        "client": [
            "com.florlet.quickalias.fabric.QuickAliasFabric"
        ],
        "modmenu": [
            "com.florlet.quickalias.fabric.QuickAliasModMenuApi"
        ]
    },
    "mixins": [
        "quickalias.mixins.json",
        "quickalias.fabric.mixins.json"
    ],
    "depends": {
        "fabricloader": ">=${fabric_loader_version}",
        "minecraft": "${minecraft_version}",
        "java": ">=${java_version}"
    },
    "suggests": {
        "fabric-api": "*",
        "modmenu": "*"
    }
}
